{
	"manifest_version": 3,
	"name": "New Tab",
	"version": "1.0.0",
	"description": "Minimal Dia-inspired new tab page with search",
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"host_permissions": ["https://suggestqueries.google.com/*"],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}
